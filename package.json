{
	"name": "obsidian-sync-evo",
	"version": "0.3.1",
	"description": "Sync Evo: sync an Obsidian vault with a GitHub repository.",
	"private": true,
	"type": "module",
	"main": "main.js",
	"license": "AGPL-3.0-only",
	"author": "seking",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seking/obsidian-sync-evo.git"
	},
	"engines": {
		"node": ">=20.12"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && tsc --noEmit -p tests && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"install:vault": "node scripts/install-to-vault.mjs",
		"release:beta": "node scripts/release-beta.mjs"
	},
	"dependencies": {
		"fflate": "0.8.3",
		"ignore": "7.0.12",
		"node-diff3": "3.2.1"
	},
	"devDependencies": {
		"@types/node": "25.9.9",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"fake-indexeddb": "6.2.5",
		"obsidian": "1.13.1",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"typescript": "6.0.3"
		}
	}
}
